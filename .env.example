# Copia este archivo como ".env" en la raíz. Valores solo para el entorno local.

# Base de datos (PostgreSQL + PostGIS en Docker)
DB_HOST=localhost
DB_PUERTO=5433
DB_NOMBRE=reciclomap
DB_NOMBRE_PRUEBAS=reciclomap_pruebas

# Usuario dueño: crea las tablas y ejecuta las migraciones
DB_PROPIETARIO=reciclomap
DB_PROPIETARIO_CLAVE=cambia_esta_clave_local

# Usuario "rm_api": uso general, sin lectura de ubicaciones
DB_API_CLAVE=cambia_esta_clave_api

# Usuario "rm_admin": administración, solo lectura sobre precios
DB_ADMIN_CLAVE=cambia_esta_clave_admin

# Imagen de Docker. En Mac con chip Apple se ejecuta emulada y funciona igual.
DB_IMAGEN=postgis/postgis:16-3.5
DB_PLATAFORMA=linux/amd64

# Puertos fijos: la web siempre en 3000 (lo fija el script de la web) y la API en 3001.
# Los orígenes autorizados en Google (OAuth y clave del mapa) dependen de ellos; si algo los ocupa, ciérralo en vez de cambiarlos.
# API
API_PUERTO=3001
API_LIMITE_POR_MINUTO=120
WEB_ORIGEN=http://localhost:3000
LOG_NIVEL=info

# Servicios de apoyo en Docker
REDIS_PUERTO=6380
CORREO_PUERTO_SMTP=1025
CORREO_PUERTO_WEB=8025

# Sesiones. Usa un texto aleatorio de 32 caracteres o más; cada integrante el suyo
JWT_SECRETO=cambia_este_secreto_local_de_32_caracteres_o_mas
SESION_ACCESO_MINUTOS=15
SESION_REFRESCO_DIAS=30

# Mensajes (códigos por SMS y correo). "simulado" los muestra en el buzón de pruebas: http://localhost:8025
MENSAJERIA_PROVEEDOR=simulado
# Solo en local: la API devuelve el código en la respuesta, para Postman. Nunca en producción
MENSAJERIA_EXPONER_CODIGO=true
CORREO_HOST=localhost

# Inicio con Google: ID de cliente OAuth de tipo "Aplicación web" (es público, no es una clave secreta)
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Google Maps: clave de navegador restringida por dominio (HTTP referrer) a Maps JavaScript API y Places API (New).
# Obligatoria en producción (la API no arranca sin ella). Vacía en desarrollo: solo lista y el pin se reemplaza por la zona
GOOGLE_MAPS_CLAVE_NAVEGADOR=
GOOGLE_MAPS_ID_MAPA=DEMO_MAP_ID
# Clave de servidor (Routes API, restringida por IP) para el trazo de "Cómo llegar". Vacía: solo se ofrece el enlace a Google Maps
GOOGLE_MAPS_CLAVE_SERVIDOR=

# Correo de soporte que se muestra en el Centro de ayuda
SOPORTE_CORREO=soporte@reciclomap.pe

# Avisos push (opcional). Genera el par con: npx web-push generate-vapid-keys
# Sin claves la app funciona igual: los avisos llegan en vivo mientras está abierta
PUSH_CLAVE_PUBLICA=
PUSH_CLAVE_PRIVADA=
PUSH_CONTACTO=mailto:soporte@reciclomap.pe

# Contraseña de prueba de las cuentas de la semilla (solo local)
SEMILLA_CLAVE=Prueba2026!

# Fotos: almacén compatible con S3 (SeaweedFS en local). En pruebas automáticas puede ser "memoria"
ALMACEN_PROVEEDOR=s3
ALMACEN_URL=http://localhost:8333
ALMACEN_PUERTO=8333
ALMACEN_REGION=us-east-1
ALMACEN_BUCKET=reciclomap-fotos
ALMACEN_CLAVE_ACCESO=reciclomap_local
ALMACEN_CLAVE_SECRETA=cambia_esta_clave_local

# Web: dirección interna de la API (la web le reenvía /api/v1) y WhatsApp de soporte (opcional)
API_URL_INTERNA=http://localhost:3001
NEXT_PUBLIC_SOPORTE_WHATSAPP=

# Intentos de acceso por minuto en cada ruta de /auth (sube solo en pruebas automáticas)
API_LIMITE_ACCESO_POR_MINUTO=10
API_LIMITE_REFRESCO_POR_MINUTO=60
