{
  "name": "@reciclomap/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "eslint src e2e scripts",
    "tipos": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:flujos": "playwright test --config playwright.flujos.config.ts",
    "peso": "tsx scripts/medir-peso.ts",
    "test:publico": "playwright test --config playwright.publico.config.ts"
  },
  "dependencies": {
    "@reciclomap/shared": "workspace:*",
    "dotenv": "^18.0.10",
    "leaflet": "1.9.4",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/google.maps": "^3.66.10",
    "@types/leaflet": "1.9.21",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.0",
    "eslint-config-next": "16.4.6",
    "jsdom": "^30.0.0",
    "tailwindcss": "4.3.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  }
}
