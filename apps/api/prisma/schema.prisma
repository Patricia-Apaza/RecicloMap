model Operacion {
  id                 String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  publicacionId      String          @unique @map("publicacion_id") @db.Uuid
  ofertaId           String          @unique @map("oferta_id") @db.Uuid
  recicladorId       String          @map("reciclador_id") @db.Uuid
  compradorId        String          @map("comprador_id") @db.Uuid
  estado             OperacionEstado @default(ACEPTADA)
  enDisputa          Boolean         @default(false) @map("en_disputa")
  kgFinal            Decimal?        @map("kg_final") @db.Decimal(8, 2)
  montoFinal         Decimal?        @map("monto_final") @db.Decimal(10, 2)
  ofertasAlAceptar   Int             @default(1) @map("ofertas_al_aceptar") @db.SmallInt
  aceptoMayorTotal   Boolean         @default(false) @map("acepto_mayor_total")
  completadaPorPlazo Boolean         @default(false) @map("completada_por_plazo")
  motivoCancelacion  String?         @map("motivo_cancelacion") @db.VarChar(200)
  canceladaPorId     String?         @map("cancelada_por_id") @db.Uuid
  creadaEn           DateTime        @default(now()) @map("creada_en") @db.Timestamptz(3)
  coordinadaEn       DateTime?       @map("coordinada_en") @db.Timestamptz(3)
  entregadaEn        DateTime?       @map("entregada_en") @db.Timestamptz(3)
  confirmadaEn       DateTime?       @map("confirmada_en") @db.Timestamptz(3)
  completadaEn       DateTime?       @map("completada_en") @db.Timestamptz(3)
  canceladaEn        DateTime?       @map("cancelada_en") @db.Timestamptz(3)
  avisoEntregaEn     DateTime?       @map("aviso_entrega_en") @db.Timestamptz(3)
  plazoAvisoEntregaHoras Int?        @map("plazo_aviso_entrega_horas") @db.SmallInt
  plazoConformidadHoras  Int?        @map("plazo_conformidad_horas") @db.SmallInt
  correccionPedidaEn DateTime?       @map("correccion_pedida_en") @db.Timestamptz(3)

  publicacion  Publicacion @relation(fields: [publicacionId], references: [id])
  oferta       Oferta      @relation(fields: [ofertaId], references: [id])
  reciclador   Usuario     @relation("OperacionesComoReciclador", fields: [recicladorId], references: [id])
  comprador    Comprador   @relation(fields: [compradorId], references: [id])
  canceladaPor Usuario?    @relation("OperacionCanceladaPor", fields: [canceladaPorId], references: [id], onDelete: SetNull)

  coordinacion   Coordinacion?
  calificaciones Calificacion[]
  reportes       Reporte[]
  movimientos    MovimientoPuntos[]

  @@index([recicladorId, estado])
  @@index([compradorId, estado])
  @@index([estado, entregadaEn])
  @@index([estado, confirmadaEn])
  @@map("operacion")
}

