generator client {
  provider = "prisma-client"
  output   = "../src/generado/prisma"
}

datasource db {
  provider = "postgresql"
}

// Enumeraciones
enum Rol {
  RECICLADOR
  CENTRO
  COMPRADOR_MOVIL
  ADMIN

  @@map("rol")
}

enum UsuarioEstado {
  PENDIENTE_TELEFONO
  REGISTRO_INCOMPLETO
  ACTIVO
  SUSPENDIDO
  EN_ELIMINACION
  ELIMINADO

  @@map("usuario_estado")
}

enum ProveedorIdentidad {
  GOOGLE

  @@map("proveedor_identidad")
}

enum PropositoCodigo {
  VERIFICAR_TELEFONO
  RECUPERAR_CONTRASENA
  CAMBIAR_TELEFONO
  INICIO_ADMIN
  ELIMINAR_CUENTA
  CONFIRMAR_ACCION

  @@map("proposito_codigo")
}

enum TipoConsentimiento {
  TERMINOS
  PRIVACIDAD
  UBICACION
  MAYOR_EDAD

  @@map("tipo_consentimiento")
}

enum PropositoArchivo {
  PERFIL
  NEGOCIO
  PUBLICACION

  @@map("proposito_archivo")
}

enum CiudadEstado {
  ACTIVA
  PROXIMAMENTE

  @@map("ciudad_estado")
}

enum CompradorTipo {
  CENTRO
  MOVIL

  @@map("comprador_tipo")
}

enum Vehiculo {
  MOTO
  TRICICLO
  CAMIONETA
  CAMION

  @@map("vehiculo")
}

enum Plan {
  GRATIS
  PRO

  @@map("plan")
}

enum VerificacionEstado {
  EN_REVISION
  INFO_PEDIDA
  APROBADO
  RECHAZADO

  @@map("verificacion_estado")
}

enum VerificacionTipo {
  REGISTRO
  CAMBIO_DIRECCION

  @@map("verificacion_tipo")
}

enum Disponibilidad {
  DISPONIBLE
  EN_RUTA
  FUERA_DE_SERVICIO

  @@map("disponibilidad")
}

enum MetodoPago {
  EFECTIVO
  YAPE
  PLIN
  TRANSFERENCIA

  @@map("metodo_pago")
}

enum Demanda {
  ALTA
  MEDIA
  BAJA

  @@map("demanda")
}

enum ModeracionEstado {
  SOSPECHOSO
  CORRECCION_PEDIDA
  SUSPENDIDO

  @@map("moderacion_estado")
}

enum PublicacionEstado {
  DISPONIBLE
  CON_OFERTAS
  EN_NEGOCIACION
  FINALIZADA
  CANCELADA
  VENCIDA

  @@map("publicacion_estado")
}

enum OrigenUbicacion {
  GPS
  ZONA

  @@map("origen_ubicacion")
}

enum OfertaEstado {
  PENDIENTE
  ACEPTADA
  RECHAZADA
  NO_SELECCIONADA
  RETIRADA

  @@map("oferta_estado")
}

enum OperacionEstado {
  ACEPTADA
  EN_COORDINACION
  ENTREGADA
  CONFIRMADA
  COMPLETADA
  CANCELADA

  @@map("operacion_estado")
}

enum PuntoEncuentroTipo {
  LOCAL_DEL_CENTRO
  REFERENCIA

  @@map("punto_encuentro_tipo")
}

enum Franja {
  MANANA
  TARDE
  NOCHE

  @@map("franja")
}

enum DestinoCalificacion {
  NEGOCIO
  RECICLADOR

  @@map("destino_calificacion")
}

enum RegistroEstado {
  PENDIENTE
  CONFIRMADO
  RECHAZADO
  VENCIDO

  @@map("registro_estado")
}

enum ReporteTipo {
  NEGOCIO
  OPERACION
  RESENA

  @@map("reporte_tipo")
}

enum ReporteMotivo {
  PRECIO
  CERRADO
  UBICACION
  FALSA
  OTRO
  NO_LLEGO
  PESO
  PAGO
  TRATO
  NO_CONFIRMA
  NO_CONFORME
  RESENA_INAPROPIADA

  @@map("reporte_motivo")
}

enum ReporteEstado {
  PENDIENTE
  EN_REVISION
  CORRECCION_PEDIDA
  RESUELTO
  DESCARTADO

  @@map("reporte_estado")
}

enum ResolucionIncidencia {
  KILOS_CORREGIDOS
  CERRADA_CON_KILOS_VIGENTES
  ANULADA

  @@map("resolucion_incidencia")
}

enum AvisoEstado {
  ACTIVO
  OCULTO

  @@map("aviso_estado")
}

enum AvisoTipo {
  PROMOCION
  ANUNCIO
  NECESIDAD
  CAMPANA

  @@map("aviso_tipo")
}

enum NotificacionTipo {
  OFERTA
  ACEPTACION
  OPERACION
  DESAFIO
  GIRO
  PRECIO
  AVISO
  CONFIRMACION
  INSIGNIA
  NIVEL
  PLAN
  CUENTA

  @@map("notificacion_tipo")
}

enum InsigniaCategoria {
  KILOS
  CONSTANCIA
  CALIDAD
  PRECIO
  COMUNIDAD
  JUEGO

  @@map("insignia_categoria")
}

enum DesafioTipo {
  KG_TOTAL
  KG_MATERIAL
  OPERACIONES
  OPERACIONES_MATERIAL
  CALIFICACIONES
  DIAS_PUBLICANDO

  @@map("desafio_tipo")
}

enum PuntosMotivo {
  OPERACION
  REGISTRO_DIRECTO
  DESAFIO
  INVITACION
  RULETA
  CORRECCION

  @@map("puntos_motivo")
}

enum GiroOrigen {
  PUNTOS
  META_MES

  @@map("giro_origen")
}

enum PremioTipo {
  PUNTOS
  OBJETO
  SIN_PREMIO

  @@map("premio_tipo")
}

enum PremioGanadoEstado {
  POR_RECLAMAR
  RECLAMADO
  ENTREGADO
  VENCIDO
  RENUNCIADO

  @@map("premio_ganado_estado")
}

enum MedioPagoPlan {
  YAPE
  EFECTIVO

  @@map("medio_pago_plan")
}

enum SolicitudPlanEstado {
  PENDIENTE
  APROBADA
  RECHAZADA
  CANCELADA

  @@map("solicitud_plan_estado")
}

enum AuditoriaTipo {
  AVISOS
  VERIFICACION
  PRECIOS
  USUARIOS
  REPORTES
  PLAN
  PARAMETROS
  PREMIOS
  CIUDADES
  CONFIGURACION

  @@map("auditoria_tipo")
}

// Único resultado posible de las funciones de distancia: nunca un número
enum TramoDistancia {
  MENOS_DE_1_KM @map("menos de 1 km")
  DE_1_A_2_KM   @map("1–2 km")
  DE_2_A_5_KM   @map("2–5 km")
  MAS_DE_5_KM   @map("más de 5 km")

  @@map("tramo_distancia")
}

// Catálogos
model Ciudad {
  id                     Int          @id @default(autoincrement()) @db.SmallInt
  nombre                 String       @unique @db.VarChar(60)
  region                 String       @db.VarChar(60)
  estado                 CiudadEstado @default(PROXIMAMENTE)
  verificadoresAsignados Boolean      @default(false) @map("verificadores_asignados")
  preciosBaseCargados    Boolean      @default(false) @map("precios_base_cargados")
  creadaEn               DateTime     @default(now()) @map("creada_en") @db.Timestamptz(3)

  zonas         Zona[]
  usuarios      Usuario[]
  publicaciones Publicacion[]
  listaEspera   ListaEsperaCiudad[]

  @@map("ciudad")
}

model Zona {
  id       Int                                  @id @default(autoincrement()) @db.SmallInt
  ciudadId Int                                  @map("ciudad_id") @db.SmallInt
  nombre   String                               @db.VarChar(80)
  centro   Unsupported("geography(Point,4326)")

  ciudad       Ciudad             @relation(fields: [ciudadId], references: [id])
  compradores  Comprador[]
  recicladores RecicladorPerfil[]
  paradas      ParadaRuta[]

  @@unique([ciudadId, nombre])
  @@index([centro], type: Gist)
  @@map("zona")
}

model ListaEsperaCiudad {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ciudadId  Int       @map("ciudad_id") @db.SmallInt
  usuarioId String?   @map("usuario_id") @db.Uuid
  creadaEn  DateTime  @default(now()) @map("creada_en") @db.Timestamptz(3)
  avisadaEn DateTime? @map("avisada_en") @db.Timestamptz(3)

  ciudad  Ciudad   @relation(fields: [ciudadId], references: [id])
  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([ciudadId, usuarioId])
  @@map("lista_espera_ciudad")
}

model Material {
  id     Int    @id @default(autoincrement()) @db.SmallInt
  codigo String @unique @db.VarChar(20)
  nombre String @unique @db.VarChar(40)
  orden  Int    @db.SmallInt

  recicladores  RecicladorMaterial[]
  precios       PrecioMaterial[]
  publicaciones Publicacion[]
  registros     RegistroReciclaje[]
  reportes      Reporte[]
  plantillas    PlantillaDesafio[]
  solicitudes   SolicitudLlegada[]
  visitas       EventoVisita[]

  @@map("material")
}

model Nivel {
  id     Int     @id @db.SmallInt
  nombre String  @unique @db.VarChar(40)
  kgMin  Decimal @unique @map("kg_min") @db.Decimal(10, 2)

  perfiles RecicladorPerfil[]

  @@map("nivel")
}

model Insignia {
  id          Int               @id @default(autoincrement()) @db.SmallInt
  codigo      String            @unique @db.VarChar(40)
  nombre      String            @unique @db.VarChar(40)
  categoria   InsigniaCategoria
  descripcion String            @db.VarChar(160)
  meta        Int
  unidad      String            @db.VarChar(20)
  destacada   Boolean           @default(false)
  orden       Int               @db.SmallInt

  usuarios UsuarioInsignia[]

  @@map("insignia")
}

model EtiquetaCalificacion {
  id      Int                 @id @default(autoincrement()) @db.SmallInt
  destino DestinoCalificacion
  codigo  String              @db.VarChar(40)
  nombre  String              @db.VarChar(40)
  activa  Boolean             @default(true)

  calificaciones CalificacionEtiqueta[]

  @@unique([destino, codigo])
  @@map("etiqueta_calificacion")
}

model ParametroRegla {
  clave        String  @id @db.VarChar(60)
  minimo       Decimal
  maximo       Decimal
  costoPremios Boolean @default(false) @map("costo_premios")

  @@map("parametro_regla")
}

model ParametroHistorial {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clave         String   @db.VarChar(60)
  valorAnterior String   @map("valor_anterior") @db.VarChar(200)
  valorNuevo    String   @map("valor_nuevo") @db.VarChar(200)
  motivo        String   @db.VarChar(200)
  adminId       String   @map("admin_id") @db.Uuid
  txId          BigInt   @default(dbgenerated("txid_current()")) @map("tx_id")
  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)

  admin Usuario @relation("ParametroCambiadoPor", fields: [adminId], references: [id])

  @@index([clave, creadoEn])
  @@map("parametro_historial")
}

model Parametro {
  clave         String   @id @db.VarChar(60)
  valor         String   @db.VarChar(200)
  descripcion   String   @db.VarChar(200)
  actualizadoEn DateTime @default(now()) @map("actualizado_en") @db.Timestamptz(3)

  @@map("parametro")
}

// Cuentas
model Usuario {
  id                   String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rol                  Rol
  nombre               String        @db.VarChar(120)
  telefono             String        @unique @db.Char(9)
  telefonoVerificadoEn DateTime?     @map("telefono_verificado_en") @db.Timestamptz(3)
  correo               String?       @unique @db.VarChar(120)
  correoVerificadoEn   DateTime?     @map("correo_verificado_en") @db.Timestamptz(3)
  hashContrasena       String?       @map("hash_contrasena") @db.VarChar(255)
  fotoId               String?       @unique @map("foto_id") @db.Uuid
  ciudadId             Int           @map("ciudad_id") @db.SmallInt
  estado               UsuarioEstado @default(PENDIENTE_TELEFONO)
  motivoSuspension     String?       @map("motivo_suspension") @db.VarChar(200)
  suspendidoEn         DateTime?     @map("suspendido_en") @db.Timestamptz(3)
  suspendidoPorId      String?       @map("suspendido_por_id") @db.Uuid
  creadoEn             DateTime      @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn        DateTime      @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(3)
  eliminadoEn          DateTime?     @map("eliminado_en") @db.Timestamptz(3)
  eliminacionSolicitadaEn DateTime?  @map("eliminacion_solicitada_en") @db.Timestamptz(3)
  eliminacionProgramadaEn DateTime?  @map("eliminacion_programada_en") @db.Timestamptz(3)
  fallosAcceso         Int           @default(0) @map("fallos_acceso") @db.SmallInt
  accesoBloqueadoHasta DateTime?     @map("acceso_bloqueado_hasta") @db.Timestamptz(3)

  ciudad              Ciudad               @relation(fields: [ciudadId], references: [id])
  foto                Archivo?             @relation("FotoPerfil", fields: [fotoId], references: [id], onDelete: SetNull)
  suspendidoPor       Usuario?             @relation("CuentasSuspendidas", fields: [suspendidoPorId], references: [id], onDelete: SetNull)
  suspendidas         Usuario[]            @relation("CuentasSuspendidas")
  avisosOcultados     Aviso[]              @relation("AvisosOcultados")
  parametrosCambiados ParametroHistorial[] @relation("ParametroCambiadoPor")

  sesiones                 Sesion[]
  codigos                  CodigoVerificacion[]
  identidades              IdentidadExterna[]
  consentimientos          Consentimiento[]
  registrosPrivacidad      RegistroPrivacidad[]
  exportaciones            ExportacionDatos[]
  archivos                 Archivo[]             @relation("ArchivosPropios")
  preferencia              PreferenciaUsuario?
  suscripcionesPush        SuscripcionPush[]
  perfilReciclador         RecicladorPerfil?     @relation("PerfilReciclador")
  invitados                RecicladorPerfil[]    @relation("InvitadoPor")
  materiales               RecicladorMaterial[]
  comprador                Comprador?
  borradorNegocio          CompradorBorrador?
  verificacionesRevisadas  Verificacion[]
  preciosActualizados      PrecioMaterial[]
  historialPrecios         HistorialPrecio[]
  moderaciones             ModeracionPrecio[]
  resenasOcultadas         ResenaOculta[]
  alertasDescartadas       AlertaDescartada[]
  publicaciones            Publicacion[]         @relation("PublicacionesPropias")
  publicacionesCanceladas  Publicacion[]         @relation("PublicacionCanceladaPor")
  operaciones              Operacion[]           @relation("OperacionesComoReciclador")
  operacionesCanceladas    Operacion[]           @relation("OperacionCanceladaPor")
  calificacionesHechas     Calificacion[]        @relation("CalificacionAutor")
  calificacionesRecibidas  Calificacion[]        @relation("CalificacionDestino")
  registros                RegistroReciclaje[]
  reportesHechos           Reporte[]             @relation("ReporteAutor")
  reportesResueltos        Reporte[]             @relation("ReporteResueltoPor")
  favoritos                Favorito[]
  busquedas                BusquedaGuardada[]
  notificaciones           Notificacion[]
  insignias                UsuarioInsignia[]
  desafios                 UsuarioDesafio[]
  movimientosPuntos        MovimientoPuntos[]    @relation("MovimientosPropios")
  movimientosPorInvitado   MovimientoPuntos[]    @relation("MovimientoPorInvitado")
  invitacionesHechas       Invitacion[]          @relation("Invitador")
  invitacionRecibida       Invitacion?           @relation("Invitado")
  giros                    Giro[]
  sorteos                  SorteoRuleta[]
  premiosGanados           PremioGanado[]
  configuracionesRuleta    RuletaConfiguracion[]
  pagosPlanRegistrados     PagoPlan[]
  solicitudesPlanDecididas SolicitudPlan[]       @relation("SolicitudPlanDecidida")
  planHistorialAdmin       PlanHistorial[]       @relation("PlanHistorialAdmin")
  auditorias               Auditoria[]
  listaEspera              ListaEsperaCiudad[]

  @@index([rol, estado])
  @@map("usuario")
}

model Sesion {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId  String    @map("usuario_id") @db.Uuid
  hashToken  String    @unique @map("hash_token") @db.Char(64)
  familia    String    @db.Uuid
  creadaEn   DateTime  @default(now()) @map("creada_en") @db.Timestamptz(3)
  expiraEn   DateTime  @map("expira_en") @db.Timestamptz(3)
  usadaEn    DateTime? @map("usada_en") @db.Timestamptz(3)
  revocadaEn DateTime? @map("revocada_en") @db.Timestamptz(3)
  agente     String?   @db.VarChar(200)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([familia])
  @@map("sesion")
}

model CodigoVerificacion {
  id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId  String?         @map("usuario_id") @db.Uuid
  destino    String          @db.VarChar(120)
  proposito  PropositoCodigo
  hashCodigo String          @map("hash_codigo") @db.Char(64)
  intentos   Int             @default(0) @db.SmallInt
  expiraEn   DateTime        @map("expira_en") @db.Timestamptz(3)
  usadoEn    DateTime?       @map("usado_en") @db.Timestamptz(3)
  creadoEn   DateTime        @default(now()) @map("creado_en") @db.Timestamptz(3)

  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([destino, proposito, creadoEn])
  @@map("codigo_verificacion")
}

model IdentidadExterna {
  id        String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId String             @map("usuario_id") @db.Uuid
  proveedor ProveedorIdentidad
  sujeto    String             @db.VarChar(120)
  creadaEn  DateTime           @default(now()) @map("creada_en") @db.Timestamptz(3)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([proveedor, sujeto])
  @@unique([usuarioId, proveedor])
  @@map("identidad_externa")
}

model Consentimiento {
  id         String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId  String             @map("usuario_id") @db.Uuid
  tipo       TipoConsentimiento
  version    String             @db.VarChar(20)
  aceptadoEn DateTime           @default(now()) @map("aceptado_en") @db.Timestamptz(3)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, tipo, version])
  @@map("consentimiento")
}

model Archivo {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  propietarioId  String           @map("propietario_id") @db.Uuid
  proposito      PropositoArchivo
  clave          String           @unique @db.VarChar(200)
  claveMiniatura String?          @map("clave_miniatura") @db.VarChar(200)
  tipoMime       String           @map("tipo_mime") @db.VarChar(40)
  bytes          Int
  creadoEn       DateTime         @default(now()) @map("creado_en") @db.Timestamptz(3)

  propietario      Usuario           @relation("ArchivosPropios", fields: [propietarioId], references: [id], onDelete: Cascade)
  perfilDe         Usuario?          @relation("FotoPerfil")
  fotosNegocio     CompradorFoto[]
  fotosPublicacion PublicacionFoto[]

  @@index([propietarioId])
  @@map("archivo")
}

model PreferenciaUsuario {
  usuarioId           String  @id @map("usuario_id") @db.Uuid
  notifOfertas        Boolean @default(true) @map("notif_ofertas")
  notifPremios        Boolean @default(true) @map("notif_premios")
  notifPrecios        Boolean @default(false) @map("notif_precios")
  notifAvisos         Boolean @default(true) @map("notif_avisos")
  alertaFavPrecio     Boolean @default(true) @map("alerta_fav_precio")
  alertaFavHorario    Boolean @default(false) @map("alerta_fav_horario")
  alertaFavMovilCerca Boolean @default(false) @map("alerta_fav_movil_cerca")
  visibleEnRanking    Boolean @default(true) @map("visible_en_ranking")
  idioma              String  @default("es") @db.VarChar(5)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("preferencia_usuario")
}

model SuscripcionPush {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId String   @map("usuario_id") @db.Uuid
  endpoint  String   @unique @db.VarChar(500)
  p256dh    String   @db.VarChar(200)
  auth      String   @db.VarChar(100)
  creadaEn  DateTime @default(now()) @map("creada_en") @db.Timestamptz(3)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("suscripcion_push")
}

model RecicladorPerfil {
  usuarioId              String  @id @map("usuario_id") @db.Uuid
  zonaId                 Int?    @map("zona_id") @db.SmallInt
  sobreMi                String? @map("sobre_mi") @db.VarChar(200)
  nivelId                Int     @default(1) @map("nivel_id") @db.SmallInt
  kgTotal                Decimal @default(0) @map("kg_total") @db.Decimal(10, 2)
  puntos                 Int     @default(0)
  puntosReciclaje        Int     @default(0) @map("puntos_reciclaje")
  rachaSemanas           Int     @default(0) @map("racha_semanas") @db.SmallInt
  operacionesCompletadas Int     @default(0) @map("operaciones_completadas")
  califProm              Decimal @default(0) @map("calif_prom") @db.Decimal(3, 2)
  califCant              Int     @default(0) @map("calif_cant")
  codigoInvitacion       String  @unique @map("codigo_invitacion") @db.VarChar(20)
  invitadoPorId          String? @map("invitado_por_id") @db.Uuid

  usuario     Usuario  @relation("PerfilReciclador", fields: [usuarioId], references: [id], onDelete: Cascade)
  zona        Zona?    @relation(fields: [zonaId], references: [id])
  nivel       Nivel    @relation(fields: [nivelId], references: [id])
  invitadoPor Usuario? @relation("InvitadoPor", fields: [invitadoPorId], references: [id], onDelete: SetNull)

  @@map("reciclador_perfil")
}

model RecicladorMaterial {
  usuarioId  String @map("usuario_id") @db.Uuid
  materialId Int    @map("material_id") @db.SmallInt

  usuario  Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id])

  @@id([usuarioId, materialId])
  @@map("reciclador_material")
}

// Negocios
model Comprador {
  id                    String                                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId             String                                @unique @map("usuario_id") @db.Uuid
  tipo                  CompradorTipo
  nombreComercial       String                                @map("nombre_comercial") @db.VarChar(120)
  descripcion           String?                               @db.VarChar(160)
  direccion             String?                               @db.VarChar(160)
  zonaId                Int?                                  @map("zona_id") @db.SmallInt
