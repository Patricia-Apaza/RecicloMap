  usuario Usuario      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  premio  Premio       @relation(fields: [premioId], references: [id])

  @@index([usuarioId, estado])
  @@index([estado, venceEn])
  @@map("premio_ganado")
}

// Plan y administración
model SolicitudPlan {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  compradorId    String              @map("comprador_id") @db.Uuid
  estado         SolicitudPlanEstado @default(PENDIENTE)
  mensaje        String?             @db.VarChar(200)
  motivoDecision String?             @map("motivo_decision") @db.VarChar(200)
  decididaPorId  String?             @map("decidida_por_id") @db.Uuid
  desde          DateTime?           @db.Date
  hasta          DateTime?           @db.Date
  creadaEn       DateTime            @default(now()) @map("creada_en") @db.Timestamptz(3)
  atendidaEn     DateTime?           @map("atendida_en") @db.Timestamptz(3)

  comprador   Comprador       @relation(fields: [compradorId], references: [id], onDelete: Cascade)
  decididaPor Usuario?        @relation("SolicitudPlanDecidida", fields: [decididaPorId], references: [id])
  historial   PlanHistorial[]

  @@index([estado, creadaEn])
  @@map("solicitud_plan")
}

enum PlanAccion {
  ACTIVADO
  DESACTIVADO
  VENCIDO

  @@map("plan_accion")
}

model PlanHistorial {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  compradorId String     @map("comprador_id") @db.Uuid
  accion      PlanAccion
  desde       DateTime?  @db.Date
  hasta       DateTime?  @db.Date
  motivo      String     @db.VarChar(200)
  adminId     String?    @map("admin_id") @db.Uuid
  solicitudId String?    @map("solicitud_id") @db.Uuid
  creadoEn    DateTime   @default(now()) @map("creado_en") @db.Timestamptz(3)
  txId        BigInt     @default(dbgenerated("txid_current()")) @map("tx_id")

  comprador Comprador      @relation(fields: [compradorId], references: [id], onDelete: Cascade)
  admin     Usuario?       @relation("PlanHistorialAdmin", fields: [adminId], references: [id])
  solicitud SolicitudPlan? @relation(fields: [solicitudId], references: [id], onDelete: SetNull)

  @@index([compradorId, creadoEn])
  @@map("plan_historial")
}

model PagoPlan {
