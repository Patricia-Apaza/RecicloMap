model SorteoRuleta {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  giroId          String   @unique @map("giro_id") @db.Uuid
  usuarioId       String   @map("usuario_id") @db.Uuid
  configuracionId Int      @map("configuracion_id")
  numeroSorteado  Int      @map("numero_sorteado")
  premioId        String   @map("premio_id") @db.Uuid
