  @@unique([usuarioId, claveSolicitud])
  @@index([usuarioId, creadoEn])
  @@map("sorteo_ruleta")
}

model PremioGanado {
  id           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sorteoId     String             @unique @map("sorteo_id") @db.Uuid
  usuarioId    String             @map("usuario_id") @db.Uuid
  premioId     String             @map("premio_id") @db.Uuid
  codigo       String             @unique @db.VarChar(12)
  estado       PremioGanadoEstado @default(POR_RECLAMAR)
  puntoEntrega String             @map("punto_entrega") @db.VarChar(160)
  venceEn      DateTime           @map("vence_en") @db.Timestamptz(3)
  reclamadoEn  DateTime?          @map("reclamado_en") @db.Timestamptz(3)
  entregadoEn  DateTime?          @map("entregado_en") @db.Timestamptz(3)
  renunciadoEn DateTime?          @map("renunciado_en") @db.Timestamptz(3)
  avisoVenceEn DateTime?          @map("aviso_vence_en") @db.Timestamptz(3)
  creadoEn     DateTime           @default(now()) @map("creado_en") @db.Timestamptz(3)

