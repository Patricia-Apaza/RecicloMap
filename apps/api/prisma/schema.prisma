// Publicaciones, ofertas y operaciones
model Publicacion {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recicladorId      String            @map("reciclador_id") @db.Uuid
  materialId        Int               @map("material_id") @db.SmallInt
  cantidadKg        Decimal           @map("cantidad_kg") @db.Decimal(8, 2)
  precioEsperado    Decimal?          @map("precio_esperado") @db.Decimal(6, 2)
  nota              String?           @db.VarChar(140)
  ciudadId          Int               @map("ciudad_id") @db.SmallInt
  estado            PublicacionEstado @default(DISPONIBLE)
  motivoCancelacion String?           @map("motivo_cancelacion") @db.VarChar(200)
  canceladaPorId    String?           @map("cancelada_por_id") @db.Uuid
  origenId          String?           @map("origen_id") @db.Uuid
  creadaEn          DateTime          @default(now()) @map("creada_en") @db.Timestamptz(3)
  venceEn           DateTime          @map("vence_en") @db.Timestamptz(3)
  avisoVencerEn     DateTime?         @map("aviso_vencer_en") @db.Timestamptz(3)
  actualizadaEn     DateTime          @default(now()) @updatedAt @map("actualizada_en") @db.Timestamptz(3)

  reciclador   Usuario       @relation("PublicacionesPropias", fields: [recicladorId], references: [id])
  material     Material      @relation(fields: [materialId], references: [id])
  ciudad       Ciudad        @relation(fields: [ciudadId], references: [id])
  canceladaPor Usuario?      @relation("PublicacionCanceladaPor", fields: [canceladaPorId], references: [id], onDelete: SetNull)
  origen       Publicacion?  @relation("PublicacionDuplicada", fields: [origenId], references: [id], onDelete: SetNull)
  copias       Publicacion[] @relation("PublicacionDuplicada")

  ubicacion PublicacionUbicacion?
  fotos     PublicacionFoto[]
  ofertas   Oferta[]
  operacion Operacion?

  @@index([recicladorId, estado])
  @@index([ciudadId, estado, creadaEn])
  @@index([estado, venceEn])
  @@map("publicacion")
}

