model MovimientoPuntos {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId       String       @map("usuario_id") @db.Uuid
  puntos          Int
  motivo          PuntosMotivo
  cuentaParaGiros Boolean      @map("cuenta_para_giros")
  operacionId     String?      @map("operacion_id") @db.Uuid
  registroId      String?      @map("registro_id") @db.Uuid
  desafioId       String?      @map("desafio_id") @db.Uuid
  sorteoId        String?      @unique @map("sorteo_id") @db.Uuid
  invitadoId      String?      @map("invitado_id") @db.Uuid
  creadoEn        DateTime     @default(now()) @map("creado_en") @db.Timestamptz(3)

  usuario   Usuario            @relation("MovimientosPropios", fields: [usuarioId], references: [id], onDelete: Cascade)
  operacion Operacion?         @relation(fields: [operacionId], references: [id])
  registro  RegistroReciclaje? @relation(fields: [registroId], references: [id])
  desafio   Desafio?           @relation(fields: [desafioId], references: [id])
  sorteo    SorteoRuleta?      @relation(fields: [sorteoId], references: [id])
  invitado  Usuario?           @relation("MovimientoPorInvitado", fields: [invitadoId], references: [id], onDelete: SetNull)

  @@unique([operacionId, motivo])
  @@unique([registroId, motivo])
  @@unique([usuarioId, desafioId])
  @@unique([usuarioId, invitadoId])
  @@index([usuarioId, creadoEn])
  @@map("movimiento_puntos")
}

