{
  "name": "@reciclomap/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "build": "prisma generate && nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint src test scripts prisma",
    "tipos": "prisma generate && tsc --noEmit",
    "test": "vitest run",
    "test:bd": "vitest run --config vitest.config.bd.ts",
    "test:e2e": "vitest run --config vitest.config.e2e.ts",
    "postman": "newman run postman/reciclomap.postman_collection.json -e postman/local.postman_environment.json",
    "db:preparar": "tsx scripts/preparar-bd.ts",
    "db:migrar": "prisma migrate deploy",
    "db:sembrar": "prisma generate && prisma db seed",
    "db:reiniciar": "tsx scripts/reiniciar-bd.ts",
    "db:generar": "prisma generate",
    "admin:crear": "tsx scripts/crear-admin.ts",
    "pruebas:servir": "tsx scripts/reiniciar-bd.ts --pruebas && node dist/main.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1169.0",
    "@nestjs/common": "^12.5.0",
    "@nestjs/core": "^12.5.0",
    "@nestjs/platform-express": "^12.5.0",
    "@nestjs/platform-socket.io": "^12.5.0",
    "@nestjs/schedule": "^12.0.4",
    "@nestjs/swagger": "^12.1.2",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/websockets": "^12.5.0",
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@reciclomap/shared": "workspace:*",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.10",
    "google-auth-library": "^11.3.4",
    "helmet": "^8.3.0",
    "jose": "^6.2.17",
    "nestjs-pino": "^5.3.1",
    "nodemailer": "^10.5.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "web-push": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.13",
    "@nestjs/schematics": "^12.0.13",
    "@nestjs/testing": "^12.5.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/web-push": "^3.6.4",
    "newman": "^6.2.3",
    "prisma": "7.10.1",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  }
}
