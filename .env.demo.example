# Demostración con túnel. Copia este archivo como ".env.demo" (no se sube a Git) y completa los valores.
# Solo se usa con «pnpm demo:preparar» y «pnpm demo:iniciar»: lo demás del proyecto sigue con ".env".

# Activa el modo demostración: producción endurecida + cuentas de la semilla + código de prueba visible + mapa público de OpenStreetMap.
# Con el cartel «Versión de demostración académica…» en toda la aplicación.
NODE_ENV=production
MODO_DEMOSTRACION=true

# La dirección pública del túnel, con https y sin barra final (ngrok: https://algo.ngrok-free.app).
WEB_ORIGEN=

# Contraseña de TODAS las cuentas de prueba: la defines tú (10 caracteres o más, distinta de la de ejemplo) y se la entregas en persona.
SEMILLA_CLAVE=

# Secreto de las sesiones: 32 caracteres o más, al azar (por ejemplo: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRETO=

# Los SMS y correos son simulados y el código de prueba se muestra en pantalla.
MENSAJERIA_EXPONER_CODIGO=true

# Un intermediario de confianza delante de la API (la web, que recibe la IP real que agrega el túnel): así los límites de solicitudes
# son por persona y no de todos juntos. Verificado con Cloudflare Quick Tunnel; con ngrok se verifica igual (ver la guía).
CONFIAR_PROXY=1

# Los registros de centro y comprador necesitan el pin: el mapa de OpenStreetMap funciona sin clave.
MAPA_PIN_OBLIGATORIO=true
